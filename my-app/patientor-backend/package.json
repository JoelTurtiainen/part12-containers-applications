{
  "name": "patientor-backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "Joel Turtiainen",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --signal SIGINT --inspect-brk=0.0.0.0:9229 --nolazy src/index.ts",
    "lint": "eslint .",
    "start": "node dist/src/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/cors": "^2.8.17",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^5.0.1",
    "eslint": "^9.24.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "ignore": [
      ".git",
      "node_modules/**/node_modules"
    ],
    "execMap": {
      "ts": "npm run build & node --require ts-node/register -r tsconfig-paths/register"
    }
  }
}
